# Server configuration. Copy to `.env` and adjust before running.
PORT=5000

# MySQL connection (created through MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=hotel_management

# JWT signing
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# CORS origin of the Vite dev server
CLIENT_URL=http://localhost:5173